{
  "name": "sivro",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:frontend": "node --test tests/frontend.test.mjs tests/updates.test.mjs tests/release.test.mjs tests/appearance.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:offline": "node tests/e2e/run.mjs --offline",
    "tauri": "node scripts/with-duckdb.mjs tauri",
    "tauri:dev": "node scripts/with-duckdb.mjs tauri dev",
    "tauri:build": "node scripts/with-duckdb.mjs tauri build",
    "check": "npm run build && node scripts/with-duckdb.mjs cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
