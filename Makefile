# Sivro development tasks. `make help` lists them; CI runs the same targets.

CARGO      ?= cargo
NPM        ?= npm
DUCKDB     := node scripts/with-duckdb.mjs
APP        := --locked --manifest-path src-tauri/Cargo.toml
LIBCHECKS  := --locked --manifest-path experiments/library-checks/Cargo.toml

# Windows MSVC compiles DuckDB from source.
ifeq ($(OS),Windows_NT)
FEATURES   ?= --features source-bundled
endif

DEPS       := node_modules/.package-lock.json
DIST       := dist/index.html

.DEFAULT_GOAL := help
.PHONY: help install dev build app frontend check fmt fmt-check lint test \
        test-frontend test-backend test-libs test-e2e test-e2e-offline ci \
        perf notices clean distclean

help: ## List targets
	@grep -hE '^[a-z0-9-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-17s %s\n", $$1, $$2}'

$(DEPS): package.json package-lock.json
	$(NPM) ci

$(DIST): $(DEPS) index.html vite.config.ts tsconfig.json $(shell find src -type f)
	$(NPM) run build

install: $(DEPS) ## Install npm dependencies

dev: $(DEPS) ## Run the app with hot reload
	$(DUCKDB) tauri dev $(FEATURES)

build: $(DEPS) ## Build release packages (src-tauri/target/release/bundle)
	$(DUCKDB) tauri build $(FEATURES)

app: $(DEPS) ## Build the release binary without packaging (for test-e2e)
	$(DUCKDB) tauri build --no-bundle $(FEATURES)

frontend: $(DIST) ## Typecheck and build the frontend

check: $(DIST) ## Typecheck the frontend and the Rust app
	$(DUCKDB) $(CARGO) check $(APP) $(FEATURES)

fmt: ## Format Rust code
	$(CARGO) fmt --manifest-path src-tauri/Cargo.toml --all
	$(CARGO) fmt --manifest-path experiments/library-checks/Cargo.toml --all

fmt-check: ## Check Rust formatting
	$(CARGO) fmt --manifest-path src-tauri/Cargo.toml --all -- --check
	$(CARGO) fmt --manifest-path experiments/library-checks/Cargo.toml --all -- --check

lint: $(DIST) ## Run clippy on the app and library checks, denying warnings
	$(DUCKDB) $(CARGO) clippy $(APP) $(FEATURES) --all-targets -- -D warnings
	$(DUCKDB) $(CARGO) clippy $(LIBCHECKS) --all-targets -- -D warnings

test: test-frontend test-backend ## Run frontend and backend tests

test-frontend: $(DEPS) ## Run frontend tests
	$(NPM) run test:frontend

test-backend: $(DIST) ## Run backend reader tests
	$(DUCKDB) $(CARGO) test $(APP) $(FEATURES)

test-libs: ## Run the library checks
	$(DUCKDB) $(CARGO) test $(LIBCHECKS) -- --nocapture

test-e2e: ## Run the GUI suite against the built app (after `make app`)
	$(NPM) run test:e2e

test-e2e-offline: ## Run the GUI suite with no network (Linux)
	$(NPM) run test:e2e:offline

ci: fmt-check lint test test-libs ## Run every check CI runs, except the GUI suites

perf: ## Measure the 1M-row performance baseline
	node scripts/perf-baseline.mjs

notices: $(DEPS) ## Regenerate THIRD_PARTY_NOTICES.md
	node scripts/third-party-notices.mjs

clean: ## Remove build outputs
	rm -rf dist src-tauri/target experiments/library-checks/target

distclean: clean ## Also remove dependencies and staged DuckDB archives
	rm -rf node_modules src-tauri/libs
	grep -qs 'AUTO-GENERATED by scripts/fetch-duckdb.mjs' .cargo/config.toml && rm -f .cargo/config.toml || true
