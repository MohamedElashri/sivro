+// Layout v5 uses the superblock offset width for filtered chunk sizes.
+// FA/EA already derive it from their element headers; v2 B-trees derive it
+// from record_size, which handles both v4's variable width and v5's width.
+fn read_btree_v2_chunks<S: Source + ?Sized>(
+    source: &S,
+    address: StoredAddress,
+    dimensions: &[u64],
+    element_size: u64,
+    offset_size: u8,
+    length_size: u8,
+) -> Result<Vec<ChunkInfo>, FormatError> {
+    let invalid = || FormatError::ChunkedReadError("invalid v2 B-tree chunk index".into());
+    let header = BTreeV2Header::parse_from_source(source, address.get(), offset_size, length_size)?;
+    if !matches!(header.tree_type, 10 | 11)
+        || header.depth > 32
+        || header.total_records > 1_000_000
+        || header.node_size < 10
+        || header.node_size > 8 * 1024 * 1024
+        || header.record_size == 0
+    {
+        return Err(invalid());
+    }
+    let os = offset_size as usize;
+    let rank = dimensions.len();
+    let filtered = header.tree_type == 11;
+    let prefix = os
+        .checked_add(rank.checked_mul(8).ok_or_else(invalid)?)
+        .and_then(|n| n.checked_add(if filtered { 4 } else { 0 }))
+        .ok_or_else(invalid)?;
+    let width = (header.record_size as usize)
+        .checked_sub(prefix)
+        .ok_or_else(invalid)?;
+    if (filtered && !(1..=8).contains(&width)) || (!filtered && width != 0) {
+        return Err(invalid());
+    }
+    let logical_size = dimensions
+        .iter()
+        .try_fold(element_size, |n, d| n.checked_mul(*d).ok_or_else(invalid))?;
+    let records = collect_btree_v2_records_from_source(source, &header, offset_size, length_size)?;
+    if records.len() as u64 != header.total_records {
+        return Err(invalid());
+    }
+    records
+        .into_iter()
+        .map(|record| {
+            let raw = record.data;
+            let address = StoredAddress::new(read_offset(&raw, 0, offset_size)?);
+            let (size, mask, mut pos) = if filtered {
+                let mut size = [0; 8];
+                size[..width].copy_from_slice(&raw[os..os + width]);
+                let pos = os + width;
+                (
+                    u64::from_le_bytes(size),
+                    u32::from_le_bytes(raw[pos..pos + 4].try_into().map_err(|_| invalid())?),
+                    pos + 4,
+                )
+            } else {
+                (logical_size, 0, os)
+            };
+            let mut offsets = Vec::with_capacity(rank);
+            for dim in dimensions {
+                let scaled =
+                    u64::from_le_bytes(raw[pos..pos + 8].try_into().map_err(|_| invalid())?);
+                offsets.push(scaled.checked_mul(*dim).ok_or_else(invalid)?);
+                pos += 8;
+            }
+            Ok(ChunkInfo {
+                address,
+                chunk_size: StoredChunkSize::v4(size),
+                filter_mask: mask,
+                offsets,
+            })
+        })
+        .collect()
+}
